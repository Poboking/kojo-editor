{
  "name": "kojo-editor",
  "version": "0.4.0-beta.1",
  "private": true,
  "description": "Structure-aware editor for eraTW-style Kojo (口上) scripts - built on a fully plugin-based, game-agnostic kernel.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "test": "pnpm test:unit && pnpm test:perf",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:perf": "vitest run --config vitest.perf.config.ts",
    "test:watch": "vitest",
    "test:erbcheck": "node tools/verify.mjs erbcheck",
    "verify:engine": "node tools/clidbg-run.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "pnpm --filter @kojo/app dev",
    "tauri": "pnpm --filter @kojo/app tauri",
    "tauri:fresh": "node tools/tauri-dev-fresh.mjs",
    "audit:decoupling": "node tools/audit-decoupling.mjs",
    "verify": "node tools/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "iconv-lite": "^0.7.3",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0"
  }
}

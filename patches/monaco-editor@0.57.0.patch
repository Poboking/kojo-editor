+    /* BEGIN kojo-editor vendor patch (FIND-STATE-PERSIST) ------------------------------
+     * 为什么必须进补丁、进不了我们的代码：
+     * `FindReplaceState`（findState.js）没有出现在 monaco 的任何公开导出里，controller 的
+     * `_state` 也是私有字段；公开面 `IEditorFindOptions`（editor.api.d.ts）根本不含搜索词。
+     * ⇒ 从外面「把上次的查找状态放回去」只能 `getState() as any` 摸私有类，
+     *   或走 `editor.actions.findWithArgs` 命令（实测会弹 widget、抢焦点 56–84ms/次，
+     *   且首切时被光标所在词按 seedSearchStringFromSelection 劫持）。
+     * 本补丁把这条下注面换成**有类型的公开入口**：只改状态，不碰 widget / 焦点 / 选区 / 剪贴板 seed。
+     * ------------------------------------------------------------------------------ */
+    /**
+     * 静默设置查找状态（词 / 替换词 / 正则 / 全词 / 大小写）。
+     * 不经 `_start()`：不创建 FindWidget、不改 `isRevealed`、不动焦点、不吃选区与光标 seed；
+     * `updateHistory = false` ⇒ 不污染查找历史上拉。三开关必须全传（省略 = 保持现值）。
+     */
+    setFindStateSilently(state) {
+        this._state.change({
+            searchString: state.searchString,
+            replaceString: state.replaceString,
+            isRegex: state.isRegex,
+            wholeWord: state.wholeWord,
+            matchCase: state.matchCase,
+        }, false, false);
+    }
+    /** 读当前查找状态（同一形状的快照，供宿主按文件持久化；开关取 actual*＝未经 override 覆盖的真值） */
+    getFindStateSilently() {
+        return {
+            searchString: this._state.searchString,
+            replaceString: this._state.replaceString,
+            isRegex: this._state.actualIsRegex,
+            wholeWord: this._state.actualWholeWord,
+            matchCase: this._state.actualMatchCase,
+        };
+    }
+    /** 订阅查找状态变更（转授 `_state.onFindReplaceStateChange`，宿主据此写存，不必轮询） */
+    onDidChangeFindState(listener) {
+        return this._state.onFindReplaceStateChange(listener);
+    }
+    /* END kojo-editor vendor patch */
     highlightFindOptions(ignoreWhenVisible = false) {

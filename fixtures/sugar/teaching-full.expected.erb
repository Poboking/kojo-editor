; ============================================================
; .kojo 教学样例 · 露米娅（角色 12）· 摸屁股（310）全家桶
; ------------------------------------------------------------
; 这份文件刻意把规范 v1.4 的**每一种** .kojo 写法都用了一遍，
; 旁边的中文注释逐条讲「为什么这么写」「编译成什么」。
; 配合 fixtures/sugar/teaching-full.expected.erb 对照阅读：
; 左边是作者看到的剧本，右边是游戏真正运行的 ERB。
; 转译验证：packages/kernel/tests/sugar-teaching.transpile.test.ts
; ============================================================
; ---------- 文件头声明（新建向导自动生成，作者几乎不用手写） ----------
; ---------- 别名声明（§3.8：给数字和私有变量起人话名字） ----------
; 四种右值形态各一个：变量别名（可读写）、角色别名、数值/字符串字面量别名（只读）
; ---------- 时机一：初见（§3.2 分野表第一行） ----------
; 函数名由工具生成：@M_KOJO_MESSAGE_COM_K12_ENCOUNTER…（初见是 ENCOUNTER 族）
; ---------- 时机二：指令 310（摸屁股）——主力时机，成否子句 ----------
; ---------- 时机三：指令 311 —— MESSAGECHECK 位协议子句 ----------
; 「隐藏情景 / 隐藏口上」对应 SETBIT RESULT, 0/1（§3.2 时机内子句）
; ---------- 时机四：绝顶（PALAMCNG 分野） ----------
; ---------- 时机五：计数器 20 ----------
; ---------- 时机六：日记 ----------
; ---------- 原生直通块（§3.10） ----------
; @ 开头的块**从该行起直到下一个 @ 行或文件末尾**整块透传——因此它必须放在
; 文件最后（放中间会把后面的时机块也吞进直通块，那不是你想要的）。
; 用途：v1 未覆盖的入口（见规范附录 C）、自定义工具函数。
@M_KOJO_K12
RESULTS = "_教学示例"
RESULTS:1 = "教学用露米娅"
RESULTS:2 = "教学用样例<br>每一行注释都讲一个写法"

@M_KOJO_FLAGSETTING_K12
FLAG:眠姦口上有 = 1
FLAG:時間停止口上有 = 0

@M_KOJO_教学示例_ENCOUNTER_K12
CALL M_KOJO_教学示例_ENCOUNTER_K12_1
RETURN RESULT

@M_KOJO_教学示例_ENCOUNTER_K12_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	; 一行文本就是一行文本（§3.3）：「」是台词（作者色），无「」是旁白（灰字）。
	; 行尾「续」= 不等待，与下一行连打；默认（无「续」）= 等待玩家按键。
	PRINTFORMW 「……嗯？是谁？」
	PRINTFORML 她揉着眼睛，从阴影里探出半个脑袋。
	; 空行（§3.3，v1.4）：`空行` 编译成一条裸 `PRINTFORMW`（这里因为头部写了
	; `旁白色: 作者色`，所以不带 D），游戏里就是打出一个空行；`空行 续` = 不等待。
	; 源文件里的空白行仍然只是分隔，不进产物——想让玩家看到空行，必须显式写 `空行`。
	PRINTFORMW
	PRINTFORMW 「%CALLNAME:MASTER%……？%CALLNAME:MASTER%看得见%CALLNAME:TARGET%？」
	; 插值（§3.4）：三套原生记号统一成 {…}，内容类别由编辑器自动判：
	;   {她}/{你}          → %CALLNAME:TARGET% / %CALLNAME:MASTER%（字符串）
	;   {她的好感度}        → {CFLAG:TARGET:2}（数值，走变量字典查族）
	;   {条件 ? "A" : "B"} → \@条件?A#B\@（行内条件）
	PRINTFORMW 「\@CFLAG:TARGET:好感度 >= 500?呀，是常客呢。#唔……生面孔。\@」
	; 源折行（§3.10）：行尾 \ = 物理折行、逻辑同一行，只生成一条 PRINT
	PRINTFORMW 「自我介绍太长的时候，可以用反斜杠折到下一行，游戏里仍然是一口气打完的同一句话。」
	; 正文裸文本里的"她""你"不做替换——"她的母亲"不会被误拼（§3.8 安全线）
	PRINTFORMW 她的影子比本人更先一步凑了过来。
	; 角色别名：`{朋友}` 按声明展开（→ %CALLNAME:15%）
	PRINTFORMW 「%CALLNAME:15%也总说，人类的手比看起来更暖和。」
ENDIF
RETURN 1

@M_KOJO_教学示例_SUCCESS_COM_K12_310
TFLAG:192 = 0

@M_KOJO_教学示例_MESSAGE_COM_K12_310
CALL M_KOJO_教学示例_MESSAGE_COM_K12_310_1
RETURN RESULT

@M_KOJO_教学示例_MESSAGE_COM_K12_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	; 条件块（§3.5）：缩进即块，ENDIF 由工具补——不再有"口上全哑"的未闭合 IF
	IF TALENT:TARGET:恋慕
		PRINTFORMW 「……%CALLNAME:MASTER%想摸就摸吧。」
	ELSEIF TALENT:TARGET:思慕
		PRINTFORMW 「呀……！小露、小露都不打声招呼的吗……」
	ELSE
		PRINTFORMW 「——痴汉！」
	ENDIF
	; 单行形式（§3.5）：块头行尾直接跟内容，编译为完整 IF/ENDIF 三行
	IF MARK:TARGET:反発刻印 >= 2
		PRINTFORMW 她拍开了你的手，往后跳开了一大步。
	ENDIF
	; 范围取反（§3.5）：读作自然语言，编译为 !(X >= a && X <= b)
	IF !(CFLAG:TARGET:好感度 >= 0 && CFLAG:TARGET:好感度 <= 99)
		PRINTFORMW 「哎呀……轻一点。」
	ENDIF
	; 选择块（§3.6）：当 是 到/否则 —— SELECTCASE 的中文形态
	SELECTCASE TFLAG:193
		CASE 1
			PRINTFORMW 「不、不要……！」
		CASE 2, 3
			PRINTFORML 她红着脸，小声嘟囔着。
			PRINTFORMW 「……就、就一下哦。」
		CASE 5 TO 8
			PRINTFORMW 「呜……」
		CASEELSE
			PRINTFORMW 她什么也没说，只是微微眯起了眼睛。
	ENDSELECT
	; 随机块（§3.6）：等概率，修掉 RAND 连写的概率坑；槽位由工具分配
	LOCAL = RAND:2
	SELECTCASE LOCAL
		CASE 0
			PRINTFORMW 「……呼。」
		CASE 1
			PRINTFORMW 「再、再摸摸嘛。」
	ENDSELECT
	; 行内简写：一句话的随机用集合形态
	LOCAL:1 = RAND:3
	SELECTCASE LOCAL:1
		CASE 0
			PRINTFORMW 「嗯。」
		CASE 1
			PRINTFORMW 「哦？」
		CASE 2
			PRINTFORMW 「……哈？！」
	ENDSELECT
	; 一档多句（§3.6）：想让随机挑中的一档连说好几句，用「当 随机数：」
	; ——「随机：」的候选边界是**行**（一行一个候选）；一档多句改用「当 RAND:n：」写法
	SELECTCASE RAND:2
		CASE 0
			PRINTFORMW 「……呼。」
			PRINTFORMW 「……呼……嘻嘻。」
		CASE 1
			PRINTFORMW 「再、再摸摸嘛。」
	ENDSELECT
	; 候选组（§3.6，E18）：在「随机：」里想让某一档连说好几句，也可以把这几句用
	; 「组：」包起来——组内的多行合起来算**一个**候选（组外的裸行仍各算一个独立候选）
	LOCAL:2 = RAND:2
	SELECTCASE LOCAL:2
		CASE 0
			PRINTFORMW 「……呼。」
			PRINTFORMW 「……呼……嘻嘻。」
		CASE 1
			PRINTFORMW 「再、再摸摸嘛。」
	ENDSELECT
	; 表达式如果（§3.5）：赋值右侧的分支——必须有「否则」（穷尽保证）
	IF CFLAG:TARGET:好感度 >= 500
		CFLAG:TARGET:1088 = 1
	ELSE
		CFLAG:TARGET:1088 = 0
	ENDIF
	; 表达式当（§3.6）：SELECTCASE 的表达式形态，分支用 -> 给值
	; （左值同样是上面声明的别名——原生写法 `TFLAG:193 = 当…：` 的左值识别是已知边界）
	SELECTCASE CFLAG:TARGET:好感度
		CASE 0 TO 99
			CFLAG:TARGET:1088 = 0
		CASE 100 TO 499
			CFLAG:TARGET:1088 = 1
		CASEELSE
			CFLAG:TARGET:1088 = 2
	ENDSELECT
	; 演出写法（§3.9）：
	CALL HPH_PRINT(@"……唔。","w")
	; 着色块：SETCOLOR/RESETCOLOR 成对由工具保证，作者只管块
	SETCOLOR 0xFF8080
	PRINTFORMW 「这行是红色。」
	RESETCOLOR
	PRINTFORMW 而阴影里的她悄悄把脸别开了。
	; 原生直通行（§3.10）：全大写英文指令整行原样透传——.kojo 不是围栏
	TFLAG:192 = 0
ENDIF
RETURN 1


; ============================================================
; 发版验证样例 · 全语法面长跑用例（release-check）
; ------------------------------------------------------------
; 这份文件是**发版判据①（`.kojo` 编辑 → 保存 → 编译 → 真实游戏可跑）的输入**。
; 它与教学样例（`teaching-full.kojo`）的分工不同：
;   · 教学样例 = 每种写法各一个、旁边讲规则，给人读；
;   · 本文件 = 把写法**混在真实口上的结构里长跑**：多时机、多分野、嵌套块、
;     中英双套关键字、原生直通、别名四形态全部同时出现，用来压实机与自动化守门。
; 机器守门：packages/kernel/tests/sugar-releasecheck.transpile.test.ts
;   （转译零 error + 产物与 golden 逐字节一致 + **词表覆盖率断言**：
;    关键字表里每个语义 id 的中英两种词形、每个时机分野、每个中文运算符，
;    都必须在本文件里真实出现——漏了直接红，不靠人记得住。）
;
; 角色号为什么是 145：语料里 155 个角色有前人口上目录，145 号没有——
; 编译产物 `@M_KOJO_K145` 一族不会和别人的口上撞函数名。
; ⚠ 实机勾验时若你的存档里没有 145 号角色，**只改下面 `角色:` 那一行**即可
;   （三件套与所有函数名都由它派生，正文一个字不用动）。
; ============================================================
; ---------- 头部声明：七种可选项全用满 ----------
; ---------- 别名四形态（§3.1 / §3.8） ----------
; ① 变量别名（**可读可写**）：`X = 1`、`如果 X：` 都解析到原生变量
; ② 角色别名（只读，插值里展开成显示名）
; ③ 数值字面量别名（只读，表达式位置直接展开）
; ④ 字符串字面量别名（只读）
; ============================================================
; 时机一 · 初见（分野表第一行；无编号）
; ============================================================
; ============================================================
; 时机二 · 指令 310（主力入口：全部控制流 + 演出）
; ⚠ 这里**不写 `成否:`**：写了 `成否:` 工具就会为本时机生成 SUCCESS 函数，
; 而下面「时机五」里有独立的 `时机 成功 310：`——两处会生成**同名函数**
; `@M_KOJO_…_SUCCESS_COM_K145_310`（守门的"产物函数名不得重复"断言抓到的就是它）。
; `成否:` 的四个取值改由 316–319 四个编号分别演示。
; ============================================================
; ============================================================
; 时机三 · 指令 311（时机内子句：MESSAGECHECK 位协议）
; ============================================================
; 英文别名子句 `skip-scene` / `skip-kojo` 与中文等价。**必须换编号**：
; 同一个时机里写两次同义子句会生成两个**同名** MESSAGECHECK 函数，
; 游戏加载时就是重复定义（下面的守门断言正是为这类错误而加）。
; ============================================================
; 时机四 · 指令 312 类型: SCOM（副指令面；`类型:` 决定函数名里的段）
; ============================================================
; ---------- 命名参数 `成否:` 的四个取值各一个（§3.2 表；每个都生成自己的 SUCCESS 函数） ----------
; ============================================================
; 时机五 · 分野表逐项覆盖（每条一分野，产物函数名互不相同）
; ============================================================
; ============================================================
; 时机六 · 选项块（§3.7：一次时机只允许一个 选项，且不可嵌套）
; ============================================================
; ============================================================
; 时机七 · 英文别名等价块（同一套语法，关键字换成英文；
;          词表覆盖断言靠这一段证明"中英双收"不是纸面话）
; ============================================================
; ============================================================
; 时机八 · 中文运算符全家桶（§4.3 九个词形逐个用上）
; 一条件里混用中文与原生运算符，产物必须逐字等价——这既验"中英不串味"，
; 也是判据①实机时要看到的现象之一（分支走对边）。
; ============================================================
; ============================================================
; 原生直通块（§3.10）——**必须放文件最后**
; `@` 开头的块从该行起直到下一个 `@` 行或文件末尾整块透传；
; 放在中间会把后面的时机块一起吞掉。用途：v1 未覆盖的入口、自定义工具函数、
; 菜单 `$标签` + `GOTO` 回跳等不做糖的写法。
; ============================================================
@M_KOJO_K145
RESULTS = "_发版检查"
RESULTS:1 = "发版检查用 · 全语法面"
RESULTS:2 = "判据①实机输入<br>覆盖时机分野 / 控制流 / 插值 / 别名 / 演出 / 原生直通"

@M_KOJO_FLAGSETTING_K145
FLAG:眠姦口上有 = 1
FLAG:時間停止口上有 = 0

@M_KOJO_发版检查_ENCOUNTER_K145
CALL M_KOJO_发版检查_ENCOUNTER_K145_1
RETURN RESULT

@M_KOJO_发版检查_ENCOUNTER_K145_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	; §3.3 三种节奏：等待（默认）/ 续（不等待，与下一行连打）/ 旁白（无引号）
	PRINTFORMW 「……这里好暗。%CALLNAME:MASTER%是谁？」
	PRINTFORML 阴影里有两团光，比声音更早一步靠过来。
	PRINTFORMW 「人家可是很凶的哦？」
	; §3.4 插值四类别，由编辑器按变量字典自动判：
	;   代词 → %CALLNAME:…% ；属性 → {族:作用域:名} ；
	;   行内条件 → \@…?…#…\@ ；字面量与别名 → 原样展开
	PRINTFORMW 「%CALLNAME:15%也来了吗？\@TALENT:TARGET:恋慕?人家才不怕呢。#……别、别过来。\@」
	; §3.5 中文运算符与原生运算符混写（§4.3：等于 不等于 超过 至少 不足 至多 且 或 非）
	IF CFLAG:TARGET:好感度 >= 500 && !(MARK:TARGET:反発刻印 > 1)
		PRINTFORMW 「%CALLNAME:MASTER%的手是暖的。」
	ELSE
		PRINTFORMW 「……冷。」
	ENDIF
	; §3.10 源折行：行尾 `\` = 物理折行、逻辑同一行，产物只有一条 PRINT
	PRINTFORMW 这段旁白刻意写得很长，用来验证折行只生成一条输出指令、不会在游戏里被切成三段。
	; §3.8 安全线：正文裸文本里的"她""你"不做任何替换
	PRINTFORMW 她的影子先一步缠上%CALLNAME:MASTER%的手腕。
ENDIF
RETURN 1

@M_KOJO_发版检查_MESSAGE_COM_K145_310
CALL M_KOJO_发版检查_MESSAGE_COM_K145_310_1
RETURN RESULT

@M_KOJO_发版检查_MESSAGE_COM_K145_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	; 嵌套：如果 里面再开 如果，缩进即块（ENDIF 全由工具补）
	IF TALENT:TARGET:恋慕
		PRINTFORMW 「……随%CALLNAME:MASTER%处置。」
		IF CFLAG:TARGET:好感度 >= 500
			CALL HPH_PRINT(@"呀……好烫。","w")
		ELSE
			PRINTFORMW 「就、就一下哦。」
		ENDIF
	ELSEIF TALENT:TARGET:思慕
		PRINTFORML 「人家还没答应呢……」
		PRINTFORMW 她别过脸，耳尖却红到根。
	ELSEIF MARK:TARGET:反発刻印 >= 2
		PRINTFORMW 「——痴汉！」
	ELSE
		PRINTFORMW 「……哈？」
	ENDIF
	; §3.5 单行形式：块头行尾直接跟内容 → 编译成完整 IF / 内容 / ENDIF 三行
	IF CFLAG:TARGET:诶嘿嘿
		PRINTFORMW 她笑出了声，又赶紧捂住嘴。
	ENDIF
	; §3.5 范围与取反：`是 … 到 …` / `X 不在 a 到 b`
	IF !(CFLAG:TARGET:好感度 >= 0 && CFLAG:TARGET:好感度 <= 99)
		PRINTFORMW 「轻一点啦。」
	ENDIF
	; 英文别名 `notin` 与 `到` 的等价词形（覆盖断言要求中英两种词形都真的被解析过）
	IF !(ABL:TARGET:欲望 >= 8 && ABL:TARGET:欲望 <= 12)
		PRINTFORMW 「还不够呢。」
	ENDIF
	; §3.6 选择块：单值 / 多值 / 范围 / 兜底，四形态各一个
	SELECTCASE TFLAG:193
		CASE 1
			PRINTFORMW 「不、不要……！」
		CASE 2, 3
			PRINTFORML 她绷紧了背。
			PRINTFORMW 「……那里不行。」
		CASE 5 TO 8
			PRINTFORMW 「呜……」
		CASEELSE
			PRINTFORMW 她什么也没说，只是眯起眼睛看着%CALLNAME:MASTER%。
	ENDSELECT
	; §3.6 随机：块形态（等概率，修掉 RAND 连写的坑）与行内简写
	LOCAL = RAND:3
	SELECTCASE LOCAL
		CASE 0
			PRINTFORMW 「……呼。」
		CASE 1
			PRINTFORMW 「再、再一下嘛。」
		CASE 2
			PRINTFORMW 「%CALLNAME:MASTER%故意的吧。」
	ENDSELECT
	LOCAL:1 = RAND:3
	SELECTCASE LOCAL:1
		CASE 0
			PRINTFORMW 「嗯。」
		CASE 1
			PRINTFORMW 「哦？」
		CASE 2
			PRINTFORMW 「……哈？！」
	ENDSELECT
	; §3.5 / §3.6 表达式位置：赋值右侧的分支（`如果` 必须有 `否则`，`当` 必须有 `否则`）
	IF CFLAG:TARGET:好感度 >= 500
		CFLAG:TARGET:1088 = 1
	ELSE
		CFLAG:TARGET:1088 = 0
	ENDIF
	SELECTCASE ABL:TARGET:欲望
		CASE 0 TO 2
			TCVAR:TARGET:20 = 0
		CASE 3 TO 5
			TCVAR:TARGET:20 = 1
		CASEELSE
			TCVAR:TARGET:20 = 2
	ENDSELECT
	; §3.9 演出：心形四种模式（台词+等待 / 台词+续 / 旁白+等待 / 旁白+续）
	CALL HPH_PRINT(@"……嗯。","w")
	CALL HPH_PRINT(@"还想做……舒服ー的事……HPH","l")
	CALL HPH_PRINT(@"她的呼吸乱了半拍。","dw")
	CALL HPH_PRINT(@"她的呼吸乱了半拍。","dl")
	; §3.9 着色块：SETCOLOR / RESETCOLOR 成对由工具保证
	SETCOLOR 0xFF8080
	PRINTFORMW 「这行是红的。」
	RESETCOLOR
	; 着色块里再套如果（块内可以写其它块）
	SETCOLOR 0x80FF80
	IF CFLAG:TARGET:诶嘿嘿
		PRINTFORMW 「嘿嘿。」
	ELSE
		PRINTFORMW 「……」
	ENDIF
	RESETCOLOR
	; §3.10 原生直通行：行首全大写英文指令 → 整行原样透传（糖不是围栏）
	CFLAG:TARGET:1088 = 1
	TFLAG:192 = 0
ENDIF
RETURN 1


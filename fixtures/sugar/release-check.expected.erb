		CASE 1
			PRINTFORMW 「random 候选二」
	ENDSELECT
	LOCAL:1 = RAND:2
	SELECTCASE LOCAL:1
		CASE 0
			PRINTFORMW 「行内一」
		CASE 1
			PRINTFORMW 「行内二」
	ENDSELECT
	PRINTBUTTON "cont 标记用英文", "1"
	PRINTBUTTON "heart 用英文", "2"

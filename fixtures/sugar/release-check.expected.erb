FOR LOCAL, 4
    L_TOTAL += LOCAL
NEXT
$RELEASE_CHECK_LABEL
LOCAL = L_TOTAL
IF LOCAL >= 4
    GOTO RELEASE_CHECK_DONE
ENDIF

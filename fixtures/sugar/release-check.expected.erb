	IF TALENT:TARGET:恋慕
		PRINTFORMW 「（中文台词，英文块头）」
	ELSEIF TALENT:TARGET:思慕
		PRINTFORML 「elif 分支」
	ELSEIF CFLAG:TARGET:诶嘿嘿
		PRINTFORML 「elseif 与 elif 等价，两种词形都收」
	ELSE
		PRINTFORMW 「else 分支」
	ENDIF
	SIF CFLAG:TARGET:好感度 >= 500
		PRINTFORMW 「英文 then 与中文 则 等价（SIF 单行条件）」
	SELECTCASE TFLAG:193
		CASE 1, 2
			PRINTFORMW 「is 多值」
		CASE 0 TO 3
			PRINTFORMW 「is 范围（to）」
		CASEELSE
			PRINTFORMW 「兜底」
	ENDSELECT
	LOCAL = RAND:2
	SELECTCASE LOCAL
		CASE 0
			PRINTFORMW 「random 候选一」
		CASE 1
			PRINTFORMW 「random 候选二」
	ENDSELECT
	LOCAL:1 = RAND:2
	SELECTCASE LOCAL:1
		CASE 0
			PRINTFORMW 「行内一」
		CASE 1
			PRINTFORMW 「行内二」
	ENDSELECT
	PRINTBUTTON "cont 标记用英文", "1"
	PRINTBUTTON "heart 用英文", "2"
	INPUTS
	SELECTCASE RESULTS
		CASE "1"
			PRINTFORML 「这一行不等待」
			PRINTFORMW 「下一行才等待」
		CASE "2"
			CALL HPH_PRINT(@"……HPH","w")
	ENDSELECT
	PRINTL [1] menulabel 用英文
	$INPUT_LOOP
	INPUT
	SELECTCASE RESULT
		CASE 1
			PRINTFORMW 「英文 `menu:` 与中文 `菜单：` 同形」

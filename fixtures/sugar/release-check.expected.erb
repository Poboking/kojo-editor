@M_KOJO_发版检查_MESSAGE_COM_K145_341_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF MARK:TARGET:反発刻印 == 0 && CFLAG:TARGET:好感度 != 0
		PRINTFORMW 「条件成立。」
	ENDIF
	IF CFLAG:TARGET:好感度 < 100 || ABL:TARGET:欲望 <= 3
		PRINTFORMW 「门槛没过。」
	ENDIF
	; 单行条件（5 号任务）：`如果 <条件> 则 <语句>` → `SIF <条件>` + 紧随一条语句（**不产 ENDIF**）
	SIF CFLAG:TARGET:好感度 >= 500
		PRINTFORMW 「那就好。」
	IF ! TALENT:TARGET:恋慕
		PRINTFORMW 「还不是喜欢。」
	ENDIF
	SELECTCASE CFLAG:TARGET:好感度
		CASE 0 <= 99
			PRINTFORMW 「刚认识。」
		CASEELSE
			PRINTFORMW 「熟客。」
	ENDSELECT
	; 文件级常量当数值用（7 号批）：裸名在编译期展开成常量的整数值
	IF 1200 > 3
		PRINTFORMW 「常量读得出来。」
	ENDIF
ENDIF
RETURN 1


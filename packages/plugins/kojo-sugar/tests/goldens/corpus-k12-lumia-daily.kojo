RETURN RESULT

@M_KOJO_MESSAGE_COM_K12_436_1
;==================================================
;440,等待
;==================================================

@M_KOJO_MESSAGE_COM_K12_621
CALL M_KOJO_MESSAGE_COM_K12_621_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K12_621_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE 0
			SELECTCASE RAND:7
				CASE 1
					PRINTFORMW 「不久后就能钓到哦。耐心等吧ー」
				CASE 2
					PRINTFORMW 「啊啦、餌被吃掉了…」
				CASE 3
					PRINTFORMW 「从水里看得到吗ー、要不要藏在黑暗里？」
				CASE 4
					PRINTFORMW 「我困了……呼啊啊…」
				CASE 5
					PRINTFORMW 「嗯ー……稍微換个地方吧？」
				CASE 6
					PRINTFORMW 「要不要撒点饲料试试。來ー嘛、快过来」
				CASEELSE
					PRINTFORMW 「好可惜。别在意、再试试看嘛」
			ENDSELECT
		;木
		CASE 610
			IF TFLAG:194 > 1000
				SELECTCASE RAND:2
					CASE 1
						PRINTFORML 「好重…！　这是个大家伙…诶、这不是木頭吗ー！」
					CASEELSE
						PRINTFORML 「搞错了吗ー。希望下次能钓到像这根木头一样大的鱼。」
				ENDSELECT
				GOTO _TURI19
			ELSE
			SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 「那个不能吃呢ー。真失望。」
				CASE 2
					PRINTFORMW 「有什麽让木材变好吃的方法吗…没有啊ー果然ー」
				CASE 3
					PRINTFORMW 「你要把那个带着吗？　真是奇怪呢ー。」
				CASE 4
					PRINTFORMW 「有螃蟹在木头上啊…不要嗎」
				CASEELSE
					PRINTFORMW 「沉下去的木头…能用吗？」
			ENDSELECT
			ENDIF
		;守矢
		CASE 131
			IF TFLAG:194 > 1000
				SELECTCASE RAND:2
					CASE 1
						PRINTFORML 「符箓…？　不是。一张纸片……？」
					CASEELSE
						PRINTFORML 「钓到了奇怪的纸ー。垃圾桶在哪里？」
				ENDSELECT
				GOTO _TURI19
			ELSE
			SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 「那张纸片是什麽啊？　垃圾？」
				CASE 2
					PRINTFORMW 「收集这些东西有什么用吗ー？」
				CASE 3
					PRINTFORMW 「某种符箓？　不要靠近我哦」
				CASE 4
					PRINTFORMW 「钓到了奇怪的东西呢。是地方选得不好吗ー？」
				CASEELSE
					PRINTFORMW 「是谁扔的呢。太ー没礼貌了。」
			ENDSELECT
			ENDIF
		;跳蛋
		CASE 21
			IF TFLAG:194 > 1000
				SELECTCASE RAND:2
					CASE 1
						PRINTFORML 「…河童掉的东西？」
					CASEELSE
						PRINTFORML 「这是在水边找到的吗？」
				ENDSELECT
				GOTO _TURI19
			ELSE
			SELECTCASE RAND:5
				;CASE 1
					;PRINTFORMW 「」
				;CASE 2
					;PRINTFORMW 「」
				;CASE 3
					;PRINTFORMW 「」
				;CASE 4
					;PRINTFORMW 「」
				CASEELSE
					PRINTFORMW 「这是食材？　啊哈哈、这么白痴的东西…」
			ENDSELECT
			ENDIF
		;龍涎香
		CASE 643
			IF TFLAG:194 > 1000
				SELECTCASE RAND:2
					CASE 1
						PRINTFORML 「这是什么？　某种化石？」
					CASEELSE
						PRINTFORML 「%CALLNAME:MASTER%、钓到了奇怪的石头哦ー」
				ENDSELECT
				
				;露米娅が変なものを釣ったとき
				$_TURI19
				PRINTFORML 
				SELECTCASE RAND:5
					CASE 1
						PRINTFORMW 「不要这个ー。我扔」
					CASE 2
						PRINTFORMW 「你想要这个吗？那给你吧ー」
					CASE 3
						PRINTFORMW 「下次得钓点正经的东西…」
					CASE 4
						PRINTFORMW 「这种东西又不能吃很碍事啊」
					CASEELSE
						PRINTFORMW 「这次一定要ー钓到鱼！」
				ENDSELECT
			ELSE
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「那是什么ー？　可以吃吗？」
				CASE 2
					PRINTFORMW 「可以稍微舔一下吗？　…嗯ー、不好吃……」
				CASEELSE
					PRINTFORMW 「这是珍貴的素材吗？　嗯ー、虽然不太清楚但是太好了呢」
			ENDSELECT
			ENDIF
		;八目鰻、鰻魚
		CASE 14, 19
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「太好了呢、好大的鳗鱼！　拿去賣給米斯蒂亚吧。」
				CASE 2
					PRINTFORMW 「晚饭吃烤鳗鱼？　鳗鱼饭？　啊、口水……」
				CASEELSE
					PRINTFORMW 「鳗鱼、鳗鱼♪　盖好盖子不要逃走…这样就没問題了」
			ENDSELECT
		;青蛙
		CASE 706
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「哦、是青蛙。和盐烤鱼一起的话很好吃哦ー」
				CASE 2
					PRINTFORMW 「圆圆的看起来很好吃…钓了个好东西啊！」
				CASEELSE
					PRINTFORMW 「太好了、是青蛙！　好ー、再多钓一点吧ー！」
			ENDSELECT
		;龍之爪、氷之鱗
		CASE 606, 609
			SELECTCASE RAND:3
				CASE 1
					PRINTFORMW 「钓到了奇怪的东西呢ー。这个能做菜吗？是什么样的菜呢…」
				CASE 2
					PRINTFORMW 「这个能吃吗…会是什么样的料理呢」
				CASEELSE
					PRINTFORMW 「哦、好像钓到了什么啊。是很罕见的东西吗？」
			ENDSELECT
		;魚
		CASEELSE
			SELECTCASE RAND:5
				CASE 1
					PRINTFORMW 「太好了、钓到了！」
				CASE 2
					PRINTFORMW 「要怎麽吃呢…咕嘟」
				CASE 3
					PRINTFORMW 「就这样一直钓下去吧ー」
				CASE 4
					PRINTFORMW 「要怎么料理这条鱼？　炖鱼？　天妇罗？」
				CASEELSE
					PRINTFORMW 「很好很好、就这样增加小菜吧ー！」
			ENDSELECT
	ENDSELECT
ENDIF
RETURN 1

		;					ENDSELECT
		IF STRCOUNT(DISH_TASTE, ESCAPE("甜/"))
		CALL HPH_PRINT(@"「好甜……脸像是要融化了HPH」","W")
		ELSE
		PRINTFORMW 「不像看起来那么甜啊。%CALLNAME:MASTER%不喜欢甜的吗？」
		ENDIF
		;新料理のコピペ用
		;CASE "" , "" , "" , "" , "" , "" , "" , "" , ""
		;PRINTFORML 「」
		;PRINTFORMW 「」
		;縁起物と他料理
		CASEELSE
		IF STRCOUNT(DISH_TASTE, ESCAPE("縁起物/"))
		IF DISHNAME == "年节菜"
		「大餐耶ー。那么、先从问候开始」 续
		「新年快乐、今年也请多多关照。来、吃吧！」
		ELSEIF DISHNAME == "跨年荞麦麺"
		PRINTFORML 「%CALLNAME:MASTER%今年怎麽样？」
		「希望明年也是个好年啊ー」
		ELSEIF DISHNAME == "烤鸡"
		「哦、好大的烤全鸡」 续
		「真不愧是圣诞节！好丰盛啊ー」
		ELSEIF DISHNAME == "赏月団子"
		「同时供奉给月亮和农业之神双方的话、会得到双倍的好处吧」 续
		「那样的话明年也能吃很多呢！」
		ELSEIF DISHNAME == "万圣节蛋糕"
		「呜哇啊、好酷的蛋糕。是给我的吗？」 续
		「那我就不对你捣蛋了ー♪」
		ELSEIF DISHNAME == "圣诞蛋糕"
		「好厉害的蛋糕…从来没见过这种东西…！」 续
		CALL HPH_PRINT(@"「我也带来了珍藏的红酒。一起喝吧ーHPH」","W")
		ELSEIF DISHNAME == "七草汤"
		「我的肠胃很好所以不需要这种东西ー」 续
		「呜ー。欺负人ー」
		ELSEIF DISHNAME == "江户卷"
		「这个必须要直接这样吃吗？　感觉会卡在喉咙里的样子…」 续
		「呣咕呣咕呣咕…咕嘟。啊、意外地简单」
		ENDIF
		ELSEIF STRCOUNT(DISH_TASTE, ESCAPE("过季/"))
		;过季の固有料理もこっちに飛ばす
		$_SYOKUJI18
		SELECTCASE RAND:5
		CASE 1
		「嗯ー……感觉不应季ー」
		CASE 2
		「现在这个季节好像没法享受啊ー」
		CASE 3
		「我觉得这个季节这个菜不适合哦ー」
		CASE 4
		「这道菜不是有更时候的时期吗ー」
		CASEELSE
		「你有看日歷吗？不是现在这个時候的哦」
		ENDSELECT
		ELSE
		SELECTCASE RAND:5
		CASE 1
		「肚子饿了ー。快点吃吧ー！」
		CASE 2
		「诶…还有这样的料理啊ー…」
		CASE 3
		「你要做什么给我吃呢ー？」
		CASE 4
		PRINTFORMW 「%CALLNAME:MASTER%的料理、是什么味道呢ー」
		CASEELSE
		「我开动啦ー！」
		ENDSELECT
		ENDIF
		ENDSELECT
		空行 续
		;評価
		当 TFLAG:193：
			是 1：
				「这个…非常好吃！」 续
				随机：
					「吃了这么好吃的东西、不会胖的…再来一碗！」
					「每天都给我做饭嘛ー。拜托了ー」
					PRINTFORMW 「從來没吃过这么好吃的！%CALLNAME:MASTER%是料理天才嗎？」
					「啊啊、已经…手停不下来了…！再来一碗！」
					「每天都吃这么好吃的料理吗？好狡猾」
			是 0：
				随机：
					「还可以吧ー。下酒菜ー」
					「挺不错的呢ー。下次再做吧」
					「我喜欢这个味道ー。可以再添一碗吗？」
					「这个很好吃哦。不考慮去米斯蒂亚那里工作吗？」
					「剩下的就给我吧。我要带回去」
			是 -1：
				IF STRCOUNT(DISH_TASTE, ESCAPE("できたて/"))
				SELECTCASE RAND:5
				CASE 1
				「嗯……虽然不难吃、但是感觉也不好吃ー」
				CASE 2
				「味道稍微出乎预料啊ー」
				CASE 3
				「要是能再好吃点就好了呢ー」
				CASE 4
				「虽然有点不满意、不过味道还算能下咽吧ー」
				CASEELSE
				「这味道我不是很喜欢呢ー」
				ENDSELECT
				ELSE
				SELECTCASE RAND:5
				CASE 1
				「說不定我做的更好吃…」
				CASE 2
				「虽然很可惜…但这个稍微……」
				CASE 3
				「嗯…很奇怪的味道。不好吃。」
				CASE 4
				「我吃不下去、这个事态相當严重啊ー。」
				CASEELSE
				「呜诶…这是什么…」
				ENDSELECT
				ENDIF

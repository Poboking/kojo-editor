时机 指令 80 类型: SCOM 成否: 游戏判定：

@M_KOJO_SUCCESS_COM_K12_333
;成否判定
;TFLAG:192(-2=指令終了、-1＝強制失敗、0=COM依存、1=強制成功or大成功
TFLAG:192 =0

@M_KOJO_MESSAGE_COM_K12_333
CALL M_KOJO_MESSAGE_COM_K12_333_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K12_333_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 0
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE 6
		;大成功（酔い）
		CASE 5
		;成功（酔い）
		CASE 4
		;失敗（酔い）
		CASE 3
		;大成功
		CASE 2
		;成功
		CASE 1
		;失敗
	ENDSELECT
ENDIF
RETURN 1

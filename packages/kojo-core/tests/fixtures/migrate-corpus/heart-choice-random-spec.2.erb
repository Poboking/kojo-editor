@M_KOJO_MESSAGE_COM_K12_311_1(ARG)
#DIMS __kojo_rand_9
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
    CALL HPH_PRINT(@"……嗯。","w")
    PRINTBUTTON "用亲吻代替回答", "1"
    PRINTBUTTON "摸摸头", "2"
    PRINTBUTTON "什么也不做", "3"
    INPUTS
    SELECTCASE RESULTS
        CASE "1"
            PRINTFORMW 「……唔。」
            PRINTFORML 她轻轻闭上了眼睛。
            CALL HPH_PRINT(@"虽然，还不太明白……但是、不讨厌。","w")
        CASE "2"
            PRINTDATA
                DATAFORM 「……呼。」
                DATAFORM 「再、再摸摸嘛。」
            ENDDATA
        CASE "3"
            PRINTFORMW 「……回去吧。」
    ENDSELECT
ENDIF
RETURN 1

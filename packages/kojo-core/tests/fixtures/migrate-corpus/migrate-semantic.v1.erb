CALL M_KOJO_MESSAGE_COM_K灵梦_310_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K灵梦_310_1
;-------------------------------------------------
;記入チェック（=0, 非表示、1, 表示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	SELECTCASE TFLAG:193
		CASE 1
			PRINTFORMW 「不、不要……！」
		CASE 2 TO 3
			PRINTFORMW 「就、就一下哦。」
		CASEELSE
			PRINTFORMW 「……」
	ENDSELECT
	IF CFLAG:TARGET:好感度 >= 500
		PRINTFORMW 「嗯。」
		PRINTFORMDW 她笑了。
	ELSE
		PRINTFORMDW 她什么也没说。
	ENDIF
	IF ONCE("once")
		PRINTFORMW 「第一次呢。」
	ENDIF
	PRINTFORMDW 普通旁白。
ENDIF
RETURN 1

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@kojo/plugin-api": ["../plugin-api/src/index.ts"],
      "@kojo/kojo-core": ["../kojo-core/src/index.ts"],
      "@kojo/kojo-lang": ["../kojo-lang/src/index.ts"],
      "@kojo/kojo-lang/*": ["../kojo-lang/src/*.ts"],
      "@kojo/kojo-project-kit": ["../kojo-project-kit/src/index.ts"],
      "@kojo/kernel": ["../kernel/src/index.ts"],
      "@kojo/plugin-erb-parser": ["../plugins/erb-parser/src/index.ts"],
      "@kojo/plugin-eratw-adapter": ["../plugins/eratw-adapter/src/index.ts"],
      "@kojo/plugin-erakoumakan-adapter": ["../plugins/erakoumakan-adapter/src/index.ts"],
      "@kojo/plugin-erasqc-adapter": ["../plugins/erasqc-adapter/src/index.ts"],
      "@kojo/plugin-eratohok-adapter": ["../plugins/eratohok-adapter/src/index.ts"],
      "@kojo/plugin-eraav-adapter": ["../plugins/eraav-adapter/src/index.ts"],
      "@kojo/plugin-eratohoreverse-adapter": ["../plugins/eratohoreverse-adapter/src/index.ts"],
      "@kojo/plugin-ui-status": ["../plugins/ui-plugin-status/src/index.ts"],
      "@kojo/plugin-convention-linter": ["../plugins/convention-linter/src/index.ts"],
      "@kojo/plugin-condition-extractor": ["../plugins/condition-extractor/src/index.ts"],
      "@kojo/plugin-sav-parser": ["../plugins/sav-parser/src/index.ts"],
      "@kojo/plugin-state-replay": ["../plugins/state-replay/src/index.ts"],
      "@kojo/plugin-kojo-sugar": ["../plugins/kojo-sugar/src/index.ts"],
      "@kojo/plugin-kojo-lang": ["../plugins/kojo-lang/src/index.ts"],
      "@kojo/plugin-kojo-market": ["../plugins/kojo-market/src/index.ts"],
      "@kojo/plugin-ui-condition-matrix": ["../plugins/ui-condition-matrix/src/index.ts"],
      "@kojo/plugin-ui-convention-report": ["../plugins/ui-convention-report/src/index.ts"],
      "@kojo/plugin-ui-state-replay": ["../plugins/ui-state-replay/src/index.ts"],
      "@kojo/plugin-ui-kojo-navigator": ["../plugins/ui-kojo-navigator/src/index.ts"],
      "@kojo/plugin-ui-archive-browser": ["../plugins/ui-archive-browser/src/index.ts"],
      "@kojo/plugin-ui-snapshot-injector": ["../plugins/ui-snapshot-injector/src/index.ts"],
      "@kojo/plugin-ui-sugar-lift": ["../plugins/ui-sugar-lift/src/index.ts"],
      "@kojo/plugin-ui-sugar-preview": ["../plugins/ui-sugar-preview/src/index.ts"],
      "@kojo/plugin-ui-sugar-editor": ["../plugins/ui-sugar-editor/src/index.ts"],
      "@kojo/plugin-ui-market": ["../plugins/ui-market/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/**/*.ts", "vite.config.ts"]
}

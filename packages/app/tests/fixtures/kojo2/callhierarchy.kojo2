// 调用层级夹具（K2-LSP-CALLHIER）：`@函` / `# 模` 的同文件入边 / 出边
@函 阶乘(n)
    ? n <= 1
        @返 1
    ? 否
        @返 n * 阶乘(n - 1)

@函 甲(n)
    @返 乙(n) + 1

@函 乙(n)
    @返 甲(n) + 1

@函 入口(n)
    ! 阶乘(n)
    ! 甲(n)
    ! 外部函数(n)
    @返 0

@函 字符串陷阱()
    @返 "阶乘(1)"

@函 插值陷阱()
    > 共{阶乘(2)}次

# 模 问候(人名)
    > {人名}，早安。
    ! 阶乘(1)
    ! 入口(1)

# 模 无人问津()
    > 安静。

# 变量 计数 整数 = 0

@原生
    CALL 阶乘(1)
    ! 入口(1)

# 幕 问候场景
    > 正文
    ! 入口(2)
    ! 问候(灵梦)

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kojo-editor",
  "version": "0.4.2-beta.1",
  "identifier": "dev.kojo.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "kojo-editor · 口上编辑器",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQyOTFDMjRFNzVFOUFENTgKUldSWXJlbDFUc0tSUXBnVXVvRmd3amMxcys3WDQralpVMGhVZVZRdG0zWjd4MXVFdnlNSGhybkQK",
      "endpoints": [
        "https://github.com/Poboking/kojo-editor/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}

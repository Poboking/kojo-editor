{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kojo-editor",
  "version": "0.1.0",
  "identifier": "dev.kojo.editor",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "kojo-editor · 口上编辑器",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}

    "blank_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": -100,
        "content": {
          "type": "PATTERN",
          "value": "\\n"
        }
      }
    },
    "text_line": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 0,
        "content": {
          "type": "PATTERN",
          "value": "[^ \\t\\r\\n;「{@\\u3000][^\\n]*"
        }
      }
    },
    "string": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 5,
        "content": {
          "type": "PATTERN",
          "value": "「[^\\n]*[」\\\\]"
        }
      }
    },
    "interpolation": {
      "type": "TOKEN",
      "content": {
        "type": "PREC",
        "value": 5,
        "content": {
          "type": "PATTERN",
          "value": "\\{[^\\n]*\\}"

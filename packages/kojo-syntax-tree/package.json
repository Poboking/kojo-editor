{
  "name": "@kojo/kojo-syntax-tree",
  "version": "0.0.0",
  "private": true,
  "description": "tree-sitter 语法层：.kojo 表层 DSL 的 CST 生成与查询（高亮/折叠/缩进/错误恢复）。语言层，零游戏名词。",
  "license": "GPL-3.0-or-later",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./grammar": "./grammar.js",
    "./wasm": "./tree-sitter-kojo.wasm"
  },
  "scripts": {
    "parser": "tree-sitter generate grammar.js",
    "wasm": "tree-sitter build --wasm -o tree-sitter-kojo.wasm",
    "build": "npm run parser && npm run wasm"
  },
  "dependencies": {
    "web-tree-sitter": "^0.27.1"
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.27.1"
  },
  "tree-sitter": [
    {
      "scope": "source.kojo",
      "language": "kojo",
      "file-types": ["kojo"],
      "highlights": "queries/highlights.scm",
      "folds": "queries/folds.scm",
      "indent": "queries/indents.scm"
    }
  ]
}

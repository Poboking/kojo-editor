{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@kojo/plugin-api": ["./packages/plugin-api/src/index.ts"],
      "@kojo/kojo-project-kit": ["./packages/kojo-project-kit/src/index.ts"],
      "@kojo/kojo-core": ["./packages/kojo-core/src/index.ts"],
      "@kojo/kojo-conformance": ["./packages/kojo-conformance/src/index.ts"],
      "@kojo/kojo-syntax-tree": ["./packages/kojo-syntax-tree/src/index.ts"],
      "@kojo/kernel": ["./packages/kernel/src/index.ts"],
      "@kojo/plugin-erb-parser": ["./packages/plugins/erb-parser/src/index.ts"],
      "@kojo/plugin-eratw-adapter": ["./packages/plugins/eratw-adapter/src/index.ts"],
      "@kojo/plugin-eraakumamaid-adapter": ["./packages/plugins/eraakumamaid-adapter/src/index.ts"],
      "@kojo/plugin-convention-linter": ["./packages/plugins/convention-linter/src/index.ts"],
      "@kojo/plugin-condition-extractor": ["./packages/plugins/condition-extractor/src/index.ts"],
      "@kojo/plugin-sav-parser": ["./packages/plugins/sav-parser/src/index.ts"],
      "@kojo/plugin-state-replay": ["./packages/plugins/state-replay/src/index.ts"],
      "@kojo/plugin-kojo-sugar": ["./packages/plugins/kojo-sugar/src/index.ts"],
    "@kojo/plugin-kojo-market": ["./packages/plugins/kojo-market/src/index.ts"],
      "@kojo/plugin-ui-condition-matrix": ["./packages/plugins/ui-condition-matrix/src/index.ts"],
      "@kojo/plugin-ui-convention-report": ["./packages/plugins/ui-convention-report/src/index.ts"],
      "@kojo/plugin-ui-state-replay": ["./packages/plugins/ui-state-replay/src/index.ts"],
      "@kojo/plugin-ui-kojo-navigator": ["./packages/plugins/ui-kojo-navigator/src/index.ts"],
      "@kojo/plugin-ui-archive-browser": ["./packages/plugins/ui-archive-browser/src/index.ts"],
      "@kojo/plugin-ui-snapshot-injector": ["./packages/plugins/ui-snapshot-injector/src/index.ts"],
      "@kojo/plugin-ui-sugar-lift": ["./packages/plugins/ui-sugar-lift/src/index.ts"],
      "@kojo/plugin-ui-sugar-preview": ["./packages/plugins/ui-sugar-preview/src/index.ts"],
      "@kojo/plugin-ui-sugar-editor": ["./packages/plugins/ui-sugar-editor/src/index.ts"],
      "@kojo/plugin-ui-market": ["./packages/plugins/ui-market/src/index.ts"]
    }
  },
  "include": [
    "packages/kojo-project-kit/src/**/*.ts",
    "packages/kojo-project-kit/tests/**/*.ts",
    "packages/kojo-core/src/**/*.ts",
    "packages/kojo-core/tests/**/*.ts",
    "packages/kojo-conformance/src/**/*.ts",
    "packages/kojo-conformance/tests/**/*.ts",
    "packages/plugin-api/src/**/*.ts",
    "packages/plugin-api/tests/**/*.ts",
    "packages/kernel/src/**/*.ts",
    "packages/kernel/tests/**/*.ts",
    "packages/plugins/*/src/**/*.ts",
    "packages/plugins/*/tests/**/*.ts",
    "vitest.config.ts"
  ]
}

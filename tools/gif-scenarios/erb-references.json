{
  "name": "erb-references",
  "title": "ERB 查找引用（跨文件 3 处）",
  "fps": 8,
  "clip": null,
  "steps": [
    { "clickText": { "selector": ".tree-file", "text": "KOJO_UTIL", "settle": 1600 } },
    { "waitExpr": { "expr": "__kojoDebug.editor.info().path.includes('KOJO_UTIL')", "timeout": 15000 } },
    { "cursor": [7, 10], "settle": 400 },
    { "startSample": true },
    { "holdFrames": 5, "note": "光标停在共用口上的定义名上" },
    { "key": "f12", "mods": ["shift"], "settle": 1800 },
    { "waitExpr": { "expr": "document.querySelector('.peekview-widget') !== null", "timeout": 8000 } },
    { "holdFrames": 14, "note": "引用浮窗：三个文件各一处" },
    { "key": "escape", "settle": 500 },
    { "stopSample": true }
  ]
}

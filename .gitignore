# dependencies
node_modules/

# build outputs
dist/
build/
target/
*.tsbuildinfo
preview/
# 但**源码里的预览模块不是构建产物**：`preview/` 是"任意层级、名叫 preview 的目录"，
# 2026-10-24 eraFL 批的 `erafl-adapter/src/preview/**`（口上正文插值的纯函数）与
# `tests/preview/**` 被上面那条整体吞掉 —— `git add -A` 静默少 6 个文件，测试却在本地
# 全绿（跑的是工作区，不是索引）。这两条否定规则必须排在后面才生效。
!packages/plugins/*/src/preview/
!packages/plugins/*/tests/preview/

# local env / editor
.env
.env.local
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log

# python
__pycache__/
*.pyc

# framework / coverage
.next/
coverage/

# 工具本地数据（记忆 / 临时探针；不入库）
.workbuddy/

# 子 agent 工作树（本仓库内的临时检出，绝不入库）
.qoder/

# 本机运行时数据（探针状态等；不入库）
.local/

# local fixtures (real game data must never be committed)
fixtures/local/
fixtures/**/out/

# tauri
src-tauri/target/
packages/app/src-tauri/gen/

# agent working memory (not project data — must never be committed)
.workbuddy/

# V2: clidbg-run 转译副产物（sourceMap，回映工具即时消费，不入库）
# ALS-R3：产物落点已搬出仓库（tools/generated-output.cjs 默认 C:/tmp/kojo-generated-erb），
# 这一行是兜底——万一还有旧脚本/别的入口往仓库里写同名产物，也不给误吞的机会
*.generated.map.json
*.generated.ERB
